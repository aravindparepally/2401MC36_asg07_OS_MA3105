+// === Assignment 7: Clone & Join ===
+uint64
+sys_clone(void)
+{
+  uint64 fcn, arg, stack;
+  struct proc *np;
+
+  if(argaddr(0, &fcn) < 0 || argaddr(1, &arg) < 0 || argaddr(2, &stack) < 0)
+    return -1;
+
+  np = allocproc();
+  if(np == 0)
+    return -1;
+
+  // Threads share the parent's address space
+  np->pagetable = myproc()->pagetable;
+  np->sz = myproc()->sz;
+  np->is_thread = 1;
+  np->parent_thread = myproc();
+  np->priority = 10;
+
+  // Copy parent trapframe (keeps kernel_* fields), then redirect to fcn
+  *np->trapframe = *myproc()->trapframe;
+  np->trapframe->epc = fcn;
+  np->trapframe->sp = stack;
+  np->trapframe->a0 = arg;
+  np->trapframe->ra = 0;   // if fcn returns, fault -> clean exit
+
+  for(int i = 0; i < NOFILE; i++)
+    if(myproc()->ofile[i])
+      np->ofile[i] = filedup(myproc()->ofile[i]);
+  np->cwd = idup(myproc()->cwd);
+  safestrcpy(np->name, myproc()->name, sizeof(np->name));
+
+  np->state = RUNNABLE;
+  release(&np->lock);
+  return np->pid;
+}
