+void
+scheduler(void)
+{
+  struct proc *p;
+  struct cpu *c = mycpu();
+  c->proc = 0;
+
+  for(;;){
+    intr_on();
+    struct proc *best = 0;
+    struct proc *ran = 0;
+
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        if(p->wait_ticks > 30 && p->priority > 1) {
+          p->priority--;
+          p->wait_ticks = 0;
+        }
+        if(best == 0 || p->priority < best->priority ||
+           (p->priority == best->priority && p->wait_ticks > best->wait_ticks)) {
+          if(best != 0) release(&best->lock);
+          best = p;
+          p->wait_ticks = 0;
+        } else {
+          release(&p->lock);
+        }
+      } else {
+        release(&p->lock);
+      }
+    }
+
+    if(best != 0) {
+      // Threads share a page table, so TRAPFRAME must point to the
+      // incoming process's own trapframe page. Refresh it each switch.
+      uvmunmap(best->pagetable, TRAPFRAME, 1, 0);
+      mappages(best->pagetable, TRAPFRAME, PGSIZE, (uint64)best->trapframe, PTE_R | PTE_W);
+      sfence_vma();
+
+      best->state = RUNNING;
+      c->proc = best;
+      ran = best;
+      swtch(&c->context, &best->context);
+      c->proc = 0;
+      release(&best->lock);
+    }
+
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE && p != ran) p->wait_ticks++;
+      release(&p->lock);
+    }
+  }
+}
