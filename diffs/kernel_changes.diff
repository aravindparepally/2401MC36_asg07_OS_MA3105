+// === Assignment 7: Semaphores ===
+#define MAX_SEMS 10
+struct semaphore_def { int value; int used; };
+struct semaphore_def kernel_sems[MAX_SEMS];
+struct spinlock sem_lock;
+int sems_initialized = 0;
+
+uint64
+sys_sem_init(void)
+{
+  int id, val;
+  if(argint(0, &id) < 0 || argint(1, &val) < 0) return -1;
+  if(id < 0 || id >= MAX_SEMS) return -1;
+  if(!sems_initialized) {
+    initlock(&sem_lock, "sem_lock");
+    for(int i=0; i<MAX_SEMS; i++) kernel_sems[i].used = 0;
+    sems_initialized = 1;
+  }
+  acquire(&sem_lock);
+  kernel_sems[id].value = val;
+  kernel_sems[id].used = 1;
+  release(&sem_lock);
+  return id;
+}
+
+uint64
+sys_sem_wait(void)
+{
+  int id;
+  if(argint(0, &id) < 0) return -1;
+  if(id < 0 || id >= MAX_SEMS) return -1;
+  acquire(&sem_lock);
+  if(!kernel_sems[id].used){
+    release(&sem_lock);
+    return -1;
+  }
+  while(kernel_sems[id].value <= 0){
+    release(&sem_lock);
+    yield();
+    acquire(&sem_lock);
+  }
+  kernel_sems[id].value--;
+  release(&sem_lock);
+  return 0;
+}
+
+uint64
+sys_sem_signal(void)
+{
+  int id;
+  if(argint(0, &id) < 0) return -1;
+  if(id < 0 || id >= MAX_SEMS) return -1;
+  acquire(&sem_lock);
+  if(!kernel_sems[id].used){
+    release(&sem_lock);
+    return -1;
+  }
+  kernel_sems[id].value++;
+  wakeup(&kernel_sems[id]);
+  release(&sem_lock);
+  return 0;
+}
