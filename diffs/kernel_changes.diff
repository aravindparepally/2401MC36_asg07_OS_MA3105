+// === Assignment 7: Priority ===
+uint64
+sys_set_priority(void)
+{
+  int pid, new_priority;
+  if(argint(0, &pid) < 0 || argint(1, &new_priority) < 0) return -1;
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->pid == pid && p->state != UNUSED) {
+      p->priority = new_priority;
+      p->wait_ticks = 0;
+      release(&p->lock);
+      return 0;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
+
+uint64
+sys_get_priority(void)
+{
+  int pid;
+  if(argint(0, &pid) < 0) return -1;
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->pid == pid && p->state != UNUSED) {
+      int pr = p->priority;
+      release(&p->lock);
+      return pr;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
