+uint64
+sys_join(void)
+{
+  int pid;
+  struct proc *p, *np;
+
+  if(argint(0, &pid) < 0)
+    return -1;
+
+  p = myproc();
+
+  for(;;){
+    int found = 0;
+    for(np = proc; np < &proc[NPROC]; np++){
+      acquire(&np->lock);
+      if(np->parent_thread == p && np->pid == pid){
+        if(np->state == ZOMBIE){
+          uint64 xstate = np->xstate;
+          freeproc(np);
+          release(&np->lock);
+          return xstate;
+        }
+        found = 1;
+        release(&np->lock);
+        break;
+      }
+      release(&np->lock);
+    }
+    if(!found)
+      return -1;
+    yield();
+  }
+}
